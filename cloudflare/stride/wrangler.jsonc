// Cloudflare Worker for https://runwithstride.app (the Stride landing page).
// Deploy: from this folder, `npx wrangler@4 deploy`, or connect the repo in
// Cloudflare Workers Builds with root directory `cloudflare/stride`.
{
  "name": "runwithstride",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../public/stride",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "runwithstride.app", "custom_domain": true },
    { "pattern": "www.runwithstride.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
